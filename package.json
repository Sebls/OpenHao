{
  "name": "chinois-study-library",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 || >=24"
  },
  "scripts": {
    "postinstall": "vite build",
    "start": "node tools/server.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "setup:extractor": "python3 -m venv .venv && .venv/bin/python -m pip install -r tools/requirements.txt",
    "content:inspect": "node tools/content.mjs inspect",
    "content:extract": "node tools/content.mjs extract",
    "content:validate": "node tools/content.mjs validate",
    "content:publish": "node tools/content.mjs publish",
    "content:list": "node tools/content.mjs list",
    "content:lookup": "node tools/content.mjs lookup",
    "content:repair": "node tools/content.mjs repair",
    "content:diagnose": "node tools/content.mjs diagnose"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "ajv": "^8.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "^7.2.2"
  }
}
