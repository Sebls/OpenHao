{
  "name": "chinois-study-library",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 || >=24"
  },
  "scripts": {
    "postinstall": "vite build",
    "start": "tsx src/server/main.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "test": "node --import tsx --test tests/*.test.mjs",
    "setup:extractor": "python3 -m venv .venv && .venv/bin/python -m pip install -r tools/requirements.txt",
    "content:inspect": "tsx src/content/cli.ts inspect",
    "content:extract": "tsx src/content/cli.ts extract",
    "content:validate": "tsx src/content/cli.ts validate",
    "content:publish": "tsx src/content/cli.ts publish",
    "content:list": "tsx src/content/cli.ts list",
    "content:lookup": "tsx src/content/cli.ts lookup",
    "content:repair": "tsx src/content/cli.ts repair",
    "content:diagnose": "tsx src/content/cli.ts diagnose",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:json": "prettier \"**/*.json\" --write",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "ajv": "^8.17.1",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "prettier": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.2.2"
  }
}
